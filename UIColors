function UIColors.GetThemeNames()
	local names = {}

	for name in pairs(UIColors.Themes) do
		table.insert(names, name)
	end

	table.sort(names)

	return names
end

--==================================================
-- APPLY SHARED GRADIENT
--==================================================

function UIColors.ApplyGradient(object)
	assert(
		typeof(object) == "Instance" and object:IsA("GuiObject"),
		"UIColors.ApplyGradient expects a GuiObject"
	)

	local oldGradient = object:FindFirstChild("SharedUIGradient")

	if oldGradient and oldGradient:IsA("UIGradient") then
		oldGradient:Destroy()
	end

	local gradientSettings = UIColors.Gradient

	local gradient = Instance.new("UIGradient")
	gradient.Name = "SharedUIGradient"

	if gradientSettings.Stops and #gradientSettings.Stops >= 2 then
		-- Multi-color gradient (e.g. NeonRainbow)
		local keypoints = {}
		local count = #gradientSettings.Stops

		for i, color in ipairs(gradientSettings.Stops) do
			table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (count - 1), color))
		end

		gradient.Color = ColorSequence.new(keypoints)
	else
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, gradientSettings.Left),
			ColorSequenceKeypoint.new(0.5, gradientSettings.Middle),
			ColorSequenceKeypoint.new(1, gradientSettings.Right),
		})
	end

	gradient.Rotation = gradientSettings.Rotation
	gradient.Parent = object

	return gradient
end

--==================================================
-- AURORA BACKGROUND (theme-aware glowing orbs)
--==================================================
-- UIColors.CreateAurora(parentGuiObject) adds a glow background behind
-- everything else in that frame. Orb colors come from the active theme's
-- Gradient (Left / Middle / Right) and fade to the new colors on SetTheme().

local TweenService = game:GetService("TweenService")

local auroraRoots = setmetatable({}, { __mode = "k" })

local function applyCorner(object, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = object
end

-- Optional custom override set with UIColors.SetAuroraColors().
-- Cleared automatically when a theme is selected with SetTheme().
local auroraOverride = nil

local function auroraColor(slot)
	if auroraOverride then
		return auroraOverride[slot] or auroraOverride[#auroraOverride]
	end
	local g = UIColors.Gradient
	if slot == 1 then
		return g.Left
	elseif slot == 2 then
		return g.Middle
	end
	return g.Right
end

local function makeOrb(parent, slot, diameter, position, anchor)
	local color = auroraColor(slot)

	local holder = Instance.new("Frame")
	holder.Name = "AuroraOrb"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(diameter, diameter)
	holder.AnchorPoint = anchor
	holder.Position = position
	holder.ZIndex = 1
	holder.ClipsDescendants = false
	holder.Parent = parent

	local glowLayers = {
		{Scale = 1.00, Transparency = 0.930},
		{Scale = 0.84, Transparency = 0.900},
		{Scale = 0.68, Transparency = 0.860},
		{Scale = 0.52, Transparency = 0.800},
		{Scale = 0.36, Transparency = 0.720},
		{Scale = 0.21, Transparency = 0.620},
	}

	for i, layer in ipairs(glowLayers) do
		local glow = Instance.new("Frame")
		glow.Name = "GlowLayer" .. i
		glow.AnchorPoint = Vector2.new(0.5, 0.5)
		glow.Position = UDim2.fromScale(0.5, 0.5)
		glow.Size = UDim2.fromScale(layer.Scale, layer.Scale)
		glow.BackgroundColor3 = color
		glow.BackgroundTransparency = layer.Transparency
		glow.BorderSizePixel = 0
		glow.ZIndex = holder.ZIndex + i
		glow:SetAttribute("AuroraSlot", slot)
		glow.Parent = holder

		applyCorner(glow, UDim.new(0.5, 0))
	end

	-- Subtle inner accent
	local core = Instance.new("Frame")
	core.Name = "AuroraCore"
	core.AnchorPoint = Vector2.new(0.5, 0.5)
	core.Position = UDim2.fromScale(0.5, 0.5)
	core.Size = UDim2.fromScale(0.10, 0.10)
	core.BackgroundColor3 = color
	core.BackgroundTransparency = 0.50
	core.BorderSizePixel = 0
	core.ZIndex = holder.ZIndex + #glowLayers + 1
	core:SetAttribute("AuroraSlot", slot)
	core.Parent = holder

	applyCorner(core, UDim.new(0.5, 0))

	return holder
end

--==================================================
-- LIGHTNING EFFECT (CrimsonLightning theme only)
--==================================================
-- Random yellow lightning bolts flash across the aurora background.
-- Bolts only appear while the CrimsonLightning theme is active and no
-- custom aurora colors are set.

local function getFxLayer(root)
	local fx = root:FindFirstChild("AuroraFX")

	if not fx then
		fx = Instance.new("Frame")
		fx.Name = "AuroraFX"
		fx.BackgroundTransparency = 1
		fx.BorderSizePixel = 0
		fx.Size = UDim2.fromScale(1, 1)
		fx.ClipsDescendants = true
		fx.Active = false
		fx.ZIndex = 20
		fx.Parent = root
	end

	return fx
end

local LIGHTNING_THEME = "CrimsonLightning"
local LIGHTNING_COLOR = Color3.fromRGB(255, 228, 70)
local LIGHTNING_CORE = Color3.fromRGB(255, 250, 215)
local LIGHTNING_MIN_DELAY = 1.8
local LIGHTNING_MAX_DELAY = 5.0

local function drawSegment(parent, p1, p2, thickness, color, transparency, zIndex)
	local dx = p2.X - p1.X
	local dy = p2.Y - p1.Y
	local length = math.sqrt(dx * dx + dy * dy)

	local segment = Instance.new("Frame")
	segment.Name = "BoltSegment"
	segment.AnchorPoint = Vector2.new(0.5, 0.5)
	segment.Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)
	segment.Size = UDim2.fromOffset(thickness, length + thickness)
	segment.Rotation = math.deg(math.atan2(-dx, dy))
	segment.BackgroundColor3 = color
	segment.BackgroundTransparency = transparency
	segment.BorderSizePixel = 0
	segment.ZIndex = zIndex
	segment.Parent = parent

	return segment
end

local function buildBoltPath(startX, startY, endY, segments, jitter)
	local points = { Vector2.new(startX, startY) }
	local x = startX

	for i = 1, segments do
		x += math.random(-jitter, jitter)
		local y = startY + (endY - startY) * (i / segments)
		table.insert(points, Vector2.new(x, y))
	end

	return points
end

local function drawBoltPath(parent, points, glowThickness, coreThickness, zIndex)
	for i = 1, #points - 1 do
		drawSegment(parent, points[i], points[i + 1], glowThickness, LIGHTNING_COLOR, 0.82, zIndex)
		drawSegment(parent, points[i], points[i + 1], coreThickness, LIGHTNING_CORE, 0.05, zIndex + 1)
	end
end

local function strikeLightning(root)
	local size = root.AbsoluteSize
	if size.X < 60 or size.Y < 60 then
		return
	end

	local layer = Instance.new("Frame")
	layer.Name = "LightningStrike"
	layer.BackgroundTransparency = 1
	layer.BorderSizePixel = 0
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 20
	layer.Active = false
	layer.Parent = getFxLayer(root)

	-- Screen flash
	local flash = Instance.new("Frame")
	flash.Name = "LightningFlash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = LIGHTNING_COLOR
	flash.BackgroundTransparency = 0.86
	flash.BorderSizePixel = 0
	flash.ZIndex = 20
	flash.Parent = layer

	-- Main bolt
	local startX = math.random(math.floor(size.X * 0.12), math.floor(size.X * 0.88))
	local endY = size.Y * (0.55 + math.random() * 0.4)
	local segments = math.random(7, 11)
	local jitter = math.max(14, math.floor(size.X * 0.06))

	local mainPath = buildBoltPath(startX, 0, endY, segments, jitter)
	drawBoltPath(layer, mainPath, 10, 2, 22)

	-- Optional side branch
	if math.random() < 0.7 and #mainPath > 4 then
		local branchIndex = math.random(3, #mainPath - 2)
		local origin = mainPath[branchIndex]
		local branchEnd = origin.Y + (endY - origin.Y) * (0.4 + math.random() * 0.4)
		local branchPath = buildBoltPath(origin.X, origin.Y, branchEnd, 4, jitter)

		-- Push the branch sideways so it forks away from the main bolt.
		local push = (math.random() < 0.5 and -1 or 1) * math.random(10, 22)
		for i, point in ipairs(branchPath) do
			branchPath[i] = Vector2.new(point.X + push * (i - 1), point.Y)
		end

		drawBoltPath(layer, branchPath, 6, 1, 22)
	end

	-- Fade out. Occasionally flicker for a second, softer flash.
	local function fadeAll(duration)
		local info = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		for _, object in ipairs(layer:GetDescendants()) do
			if object:IsA("Frame") then
				TweenService:Create(object, info, { BackgroundTransparency = 1 }):Play()
			end
		end
	end

	task.wait(0.09)

	if math.random() < 0.55 then
		-- Quick double strike
		fadeAll(0.07)
		task.wait(0.08)

		if layer.Parent then
			for _, object in ipairs(layer:GetDescendants()) do
				if object.Name == "BoltSegment" then
					object.BackgroundTransparency = object.Size.X.Offset >= 6 and 0.75 or 0.1
				elseif object.Name == "LightningFlash" then
					object.BackgroundTransparency = 0.9
				end
			end
			task.wait(0.07)
		end
	end

	if layer.Parent then
		fadeAll(0.4)
		task.delay(0.5, function()
			if layer.Parent then
				layer:Destroy()
			end
		end)
	end
end

--==================================================
-- THEME EFFECTS
--==================================================
-- Each theme can have an effect. The loop below runs the effect for the
-- active theme at random intervals:
--   Monochrome       -> drifting white dust + soft light sweeps
--   NeonPink         -> twinkling sparkles + neon ring pulses
--   Emerald          -> rising green spores + glowing pulses
--   CrimsonLightning -> yellow lightning strikes
--   NeonRainbow      -> color-cycling glow, rainbow sparkles, spectrum sweeps
-- MidnightBlue has no effect (add one to UIColors Effects table below).

local function randomThemeColor()
	if UIColors.CurrentTheme == "NeonRainbow" then
		return Color3.fromHSV(math.random(), 0.8, 1)
	end

	local g = UIColors.Gradient
	local pick = math.random(1, 3)
	if pick == 1 then
		return g.Left
	elseif pick == 2 then
		return g.Middle
	end
	return g.Right
end

-- Soft glowing dot that rises and fades.
local function spawnParticle(root, opts)
	local size = root.AbsoluteSize
	if size.X < 60 or size.Y < 60 then
		return
	end

	local fx = getFxLayer(root)
	local diameter = math.random(opts.MinSize, opts.MaxSize)
	local startX = math.random(0, math.floor(size.X))
	local startY = size.Y + diameter
	local endX = startX + math.random(-opts.Sway, opts.Sway)
	local endY = size.Y * (1 - opts.Rise)
	local duration = opts.MinTime + math.random() * (opts.MaxTime - opts.MinTime)
	local color = opts.Color or randomThemeColor()

	local dot = Instance.new("Frame")
	dot.Name = "FxParticle"
	dot.AnchorPoint = Vector2.new(0.5, 0.5)
	dot.Size = UDim2.fromOffset(diameter, diameter)
	dot.Position = UDim2.fromOffset(startX, startY)
	dot.BackgroundColor3 = color
	dot.BackgroundTransparency = 1
	dot.BorderSizePixel = 0
	dot.ZIndex = 21
	dot.Parent = fx
	applyCorner(dot, UDim.new(0.5, 0))

	local halo = Instance.new("Frame")
	halo.Name = "Halo"
	halo.AnchorPoint = Vector2.new(0.5, 0.5)
	halo.Position = UDim2.fromScale(0.5, 0.5)
	halo.Size = UDim2.fromScale(3, 3)
	halo.BackgroundColor3 = color
	halo.BackgroundTransparency = 1
	halo.BorderSizePixel = 0
	halo.ZIndex = 21
	halo.Parent = dot
	applyCorner(halo, UDim.new(0.5, 0))

	TweenService:Create(
		dot,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ Position = UDim2.fromOffset(endX, endY) }
	):Play()

	local fadeIn = TweenInfo.new(duration * 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(dot, fadeIn, { BackgroundTransparency = opts.Alpha }):Play()
	TweenService:Create(halo, fadeIn, { BackgroundTransparency = opts.HaloAlpha }):Play()

	task.delay(duration * 0.7, function()
		if dot.Parent then
			local fadeOut = TweenInfo.new(duration * 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			TweenService:Create(dot, fadeOut, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(halo, fadeOut, { BackgroundTransparency = 1 }):Play()
		end
	end)

	task.delay(duration + 0.1, function()
		if dot.Parent then
			dot:Destroy()
		end
	end)
end

