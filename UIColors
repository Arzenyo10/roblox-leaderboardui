-- Change this to set the default theme.
UIColors.CurrentTheme = "Monochrome"

-- BindableEvent works for scripts requiring this module
-- in the same client or server Luau environment.
local themeChangedEvent = Instance.new("BindableEvent")
UIColors.ThemeChanged = themeChangedEvent.Event

--==================================================
-- THEME OWNERSHIP (LOCKING)
--==================================================
-- LOCKED BY DEFAULT: only the free themes below work until
-- ThemeOwnershipClient reports what the player actually owns.

local FREE_THEMES = {
	Monochrome = true,
}

local unlockedThemes = {}
for name in pairs(FREE_THEMES) do
	unlockedThemes[name] = true
end

local unlocksChangedEvent = Instance.new("BindableEvent")
UIColors.UnlocksChanged = unlocksChangedEvent.Event

-- [themeName] = developer product id (filled by ThemeOwnershipClient)
UIColors.ThemeProductIds = {}

function UIColors.SetUnlockedThemes(set)
	unlockedThemes = {}

	for name in pairs(FREE_THEMES) do
		unlockedThemes[name] = true
	end

	for name, owned in pairs(set) do
		if owned then
			unlockedThemes[name] = true
		end
	end

	unlocksChangedEvent:Fire()
end

function UIColors.IsThemeUnlocked(name)
	return unlockedThemes[name] == true
end

--==================================================
-- APPLY THE CURRENT THEME
--==================================================

local function applyThemeProperties(theme)
	for key, value in pairs(theme) do
		UIColors[key] = value
	end

	-- Backward-compatible aliases used by older scripts.
	UIColors.Background = UIColors.Backdrop
	UIColors.Panel2 = UIColors.Glass
	UIColors.Red = UIColors.GlassHover
	UIColors.Gold = UIColors.White
end

applyThemeProperties(UIColors.Themes[UIColors.CurrentTheme])

--==================================================
-- CHANGE THEME
--==================================================

function UIColors.SetTheme(themeName)
	local selectedTheme = UIColors.Themes[themeName]

	if not selectedTheme then
		warn(
			"[AFTERHOURS UIColors] Unknown theme:",
			tostring(themeName)
		)
		return false
	end

	-- Locked themes cannot be applied until the player owns them.
	if not UIColors.IsThemeUnlocked(themeName) then
		return false
	end

	if UIColors.CurrentTheme == themeName then
		return true
	end

	UIColors.CurrentTheme = themeName
	applyThemeProperties(selectedTheme)

	-- Notify subscribed UI scripts.
	themeChangedEvent:Fire(themeName, selectedTheme)

	print("[AFTERHOURS UIColors] Theme changed to:", themeName)

	return true
end

--==================================================
-- GET AVAILABLE THEMES
