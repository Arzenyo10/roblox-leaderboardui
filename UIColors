	star.TextColor3 = (math.random() < 0.45) and Color3.fromRGB(255, 255, 255) or randomThemeColor()
	star.TextTransparency = 1
	star.Rotation = math.random(-30, 30)
	star.ZIndex = 21
	star.Parent = fx

	TweenService:Create(
		star,
		TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 0.05, Rotation = star.Rotation + 40 }
	):Play()

	task.delay(0.3, function()
		if star.Parent then
			TweenService:Create(
				star,
				TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ TextTransparency = 1, Rotation = star.Rotation + 35 }
			):Play()
		end
	end)

	task.delay(0.95, function()
		if star.Parent then
			star:Destroy()
		end
	end)
end

-- Expanding neon ring.
local function spawnRing(root, color)
	local size = root.AbsoluteSize
	if size.X < 60 or size.Y < 60 then
		return
	end

	local fx = getFxLayer(root)

	local ring = Instance.new("Frame")
	ring.Name = "FxRing"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromOffset(
		math.random(20, math.floor(size.X) - 20),
		math.random(20, math.floor(size.Y) - 20)
	)
	ring.Size = UDim2.fromOffset(8, 8)
	ring.BackgroundTransparency = 1
	ring.BorderSizePixel = 0
	ring.ZIndex = 21
	ring.Parent = fx
	applyCorner(ring, UDim.new(0.5, 0))

	local ringStroke = Instance.new("UIStroke")
	ringStroke.Color = color
	ringStroke.Thickness = 2
	ringStroke.Transparency = 0.1
	ringStroke.Parent = ring

	local info = TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local diameter = math.random(90, 170)

	TweenService:Create(ring, info, { Size = UDim2.fromOffset(diameter, diameter) }):Play()
	TweenService:Create(ringStroke, info, { Transparency = 1 }):Play()

	task.delay(1.1, function()
		if ring.Parent then
			ring:Destroy()
		end
	end)
end

-- Soft diagonal light sweep across the window.
local function spawnSweep(root, rainbow)
	local size = root.AbsoluteSize
	if size.X < 60 or size.Y < 60 then
		return
	end

	local fx = getFxLayer(root)

	local bar = Instance.new("Frame")
	bar.Name = "FxSweep"
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	bar.Size = UDim2.fromOffset(rainbow and 140 or 90, size.Y * 1.9)
	bar.Position = UDim2.fromOffset(-100, size.Y / 2)
	bar.Rotation = 20
	bar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	bar.BackgroundTransparency = rainbow and 0.55 or 0.78
	bar.BorderSizePixel = 0
	bar.ZIndex = 21
	bar.Parent = fx

	local soften = Instance.new("UIGradient")
	soften.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})

	if rainbow then
		soften.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 50, 90)),
			ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 150, 40)),
			ColorSequenceKeypoint.new(0.34, Color3.fromRGB(255, 230, 60)),
			ColorSequenceKeypoint.new(0.50, Color3.fromRGB(60, 255, 130)),
			ColorSequenceKeypoint.new(0.67, Color3.fromRGB(50, 230, 255)),
			ColorSequenceKeypoint.new(0.84, Color3.fromRGB(90, 120, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(190, 80, 255)),
		})
	end

	soften.Parent = bar

	TweenService:Create(
		bar,
		TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ Position = UDim2.fromOffset(size.X + 100, size.Y / 2) }
	):Play()

	task.delay(2.1, function()
		if bar.Parent then
			bar:Destroy()
		end
	end)
end

