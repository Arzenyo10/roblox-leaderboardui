-- Slowly cycles the aurora orbs through the full color wheel.
local function cycleAuroraHue(root)
	local base = (os.clock() * 0.04) % 1

	for _, object in ipairs(root:GetDescendants()) do
		local slot = object:GetAttribute("AuroraSlot")

		if slot then
			local hue = (base + (slot - 1) / 3) % 1

			TweenService:Create(
				object,
				TweenInfo.new(0.6, Enum.EasingStyle.Linear),
				{ BackgroundColor3 = Color3.fromHSV(hue, 0.85, 1) }
			):Play()
		end
	end
end

Effects.NeonRainbow = {
	Min = 0.25,
	Max = 0.5,
	Run = function(root)
		cycleAuroraHue(root)

		spawnParticle(root, {
			MinSize = 3, MaxSize = 8,
			Sway = 45, Rise = 0.95,
			MinTime = 4, MaxTime = 7,
			Alpha = 0.08, HaloAlpha = 0.78,
		})

		if math.random() < 0.55 then
			spawnSparkle(root)
		end

		if math.random() < 0.12 then
			spawnRing(root, randomThemeColor())
		end

		if math.random() < 0.07 then
			spawnSweep(root, true)
		end
	end,
}

local function startEffectLoop(root)
	task.spawn(function()
		local lastTheme = UIColors.CurrentTheme
		local nextTime = os.clock() + 1

		while root.Parent do
			task.wait(0.15)

			local theme = UIColors.CurrentTheme

			if theme ~= lastTheme then
				lastTheme = theme
				nextTime = os.clock() + 0.5
			end

			local effect = Effects[theme]

			if effect
				and not auroraOverride
				and root:IsDescendantOf(game)
				and os.clock() >= nextTime
			then
				nextTime = os.clock() + effect.Min + math.random() * (effect.Max - effect.Min)

				task.spawn(function()
					local ok, err = pcall(effect.Run, root)
					if not ok then
						warn("[AFTERHOURS UIColors] Effect error:", err)
					end
				end)
			end
		end
	end)
end

function UIColors.CreateAurora(parent)
	assert(
		typeof(parent) == "Instance" and parent:IsA("GuiObject"),
		"UIColors.CreateAurora expects a GuiObject"
	)

	local old = parent:FindFirstChild("AuroraBackground")
	if old then
		old:Destroy()
	end

	local root = Instance.new("Frame")
	root.Name = "AuroraBackground"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = UDim2.fromScale(1, 1)
	root.ClipsDescendants = true
	root.Active = false
	root.ZIndex = 0
	root.Parent = parent

	-- Match the parent's rounded corners so orbs never poke out.
	local parentCorner = parent:FindFirstChildOfClass("UICorner")
	if parentCorner then
		parentCorner:Clone().Parent = root
	end

	local orbs = {
		{Slot = 1, Size = 560, Pos = UDim2.fromScale(0.08, 0.12)},
		{Slot = 2, Size = 500, Pos = UDim2.fromScale(0.92, 0.40)},
		{Slot = 3, Size = 460, Pos = UDim2.fromScale(0.50, 1.00)},
	}

	for i, orb in ipairs(orbs) do
		local holder = makeOrb(root, orb.Slot, orb.Size, orb.Pos, Vector2.new(0.5, 0.5))

		-- Slow, gentle drift
		TweenService:Create(
			holder,
			TweenInfo.new(9 + i * 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Position = orb.Pos + UDim2.fromOffset(40, -30) }
		):Play()
	end

	auroraRoots[root] = true
	root:SetAttribute("AuroraKey", UIColors._AuroraKey())

	-- Theme effects (dust, sparkles, spores, lightning)
	startEffectLoop(root)

	-- Safety net: if the theme/override changes and the event never reached
	-- this window, catch up within half a second.
	task.spawn(function()
		while root.Parent do
			task.wait(0.5)
			if root.Parent and root:GetAttribute("AuroraKey") ~= UIColors._AuroraKey() then
				UIColors._RefreshAurora(true)
			end
		end
	end)

	print("[AFTERHOURS UIColors] Aurora created on:", parent:GetFullName())
	return root
end

function UIColors._AuroraKey()
	if auroraOverride then
		return "custom:" .. tostring(auroraOverride[1]) .. tostring(auroraOverride[2]) .. tostring(auroraOverride[3])
	end
	return "theme:" .. tostring(UIColors.CurrentTheme)
end

local function refreshAurora(silent)
	local count = 0
	for root in pairs(auroraRoots) do
		if root.Parent then
			count += 1
			root:SetAttribute("AuroraKey", UIColors._AuroraKey())
			for _, object in ipairs(root:GetDescendants()) do
				local slot = object:GetAttribute("AuroraSlot")
				if slot then
					TweenService:Create(
						object,
						TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ BackgroundColor3 = auroraColor(slot) }
					):Play()

					-- Guarantee the final color even if another script touched
					-- this object while the fade was running.
					task.delay(0.55, function()
						if object.Parent then
							object.BackgroundColor3 = auroraColor(slot)
						end
					end)
				end
			end
		else
			auroraRoots[root] = nil
		end
	end
	if not silent then
		print("[AFTERHOURS UIColors] Aurora recolored on", count, "window(s)")
	end
end

UIColors._RefreshAurora = refreshAurora

-- Custom aurora colors, independent of the theme.
-- Usage: UIColors.SetAuroraColors(Color3.fromRGB(255,80,80), Color3.fromRGB(255,170,0), Color3.fromRGB(255,255,120))
-- Pass one color to tint all three orbs the same.
function UIColors.SetAuroraColors(first, second, third)
	assert(typeof(first) == "Color3", "SetAuroraColors expects Color3 values")
	second = second or first
	third = third or second
	auroraOverride = { first, second, third }
	refreshAurora()
end

-- Go back to the active theme's colors.
function UIColors.ResetAuroraColors()
	auroraOverride = nil
	refreshAurora()
end

themeChangedEvent.Event:Connect(function()
	auroraOverride = nil -- selecting a theme takes over again

	-- Clear leftover effects from the previous theme.
	for root in pairs(auroraRoots) do
		local fx = root.Parent and root:FindFirstChild("AuroraFX")
		if fx then
			fx:ClearAllChildren()
		end
	end

	refreshAurora()
end)

return UIColors
