local thumbCache = {}

local function loadThumb(userId, image)
	if thumbCache[userId] then
		image.Image = thumbCache[userId]
		return
	end

	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
		end)

		if ok then
			thumbCache[userId] = content
			if image.Parent then
				image.Image = content
			end
		end
	end)
end

local function buildRow(entry, rank, maxValue, me)
	local key = state.Tab
	local isMe = entry.UserId == player.UserId
	local topThree = rank <= 3

	local value = entry.Value
	if isMe and me and me[key] then
		value = math.max(value, me[key]) -- live value beats the cached board value
	end

	local function baseStroke()
		return rankColor(rank) or (isMe and UIColors.GlassHover or UIColors.Soft)
	end

	local baseTransparency = isMe and 0.05 or 0.3

	local row = new("Frame", {
		Name = "Row" .. rank,
		LayoutOrder = rank,
		Size = UDim2.new(1, -8, 0, 56),
		BorderSizePixel = 0,
	}, scroll)
	themed(row, function(r)
		r.BackgroundColor3 = UIColors.Glass
		r.BackgroundTransparency = baseTransparency
	end)
	corner(row, 10)

	local rowStroke = new("UIStroke", {
		Thickness = topThree and 1.5 or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, row)
	themed(rowStroke, function(st)
		st.Color = baseStroke()
		st.Transparency = (topThree or isMe) and 0.2 or 0.1
	end)

	-- Progress bar behind the content (relative to #1)
	local ratio = math.clamp(value / math.max(maxValue, 1), 0.03, 1)
	local bar = new("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BorderSizePixel = 0,
		ZIndex = 1,
	}, row)
	corner(bar, 10)
	themed(bar, function(b)
		b.BackgroundColor3 = UIColors.White
		b.BackgroundTransparency = topThree and 0.8 or 0.9
		UIColors.ApplyGradient(b)
	end)
	TweenService:Create(
		bar,
		TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, math.min(rank, 15) * 0.02),
		{ Size = UDim2.new(ratio, 0, 1, 0) }
	):Play()

	-- Rank number
	label({
		Name = "Rank",
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(0, 46, 1, 0),
		Text = "#" .. rank,
		TextSize = topThree and 20 or 16,
		ZIndex = 2,
	}, row, function()
		return rankColor(rank) or UIColors.Muted
	end)

	-- Avatar
	local avatar = new("ImageLabel", {
		Name = "Avatar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 58, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		BorderSizePixel = 0,
		ZIndex = 2,
	}, row)
	corner(avatar, 0, 1)
	themed(avatar, function(a)
		a.BackgroundColor3 = UIColors.Black
	end)
	stroke(avatar, 2, function()
		return rankColor(rank) or (isMe and UIColors.AvatarLight or UIColors.AvatarAmbient)
	end, topThree and 0 or 0.35)
	loadThumb(entry.UserId, avatar)

	-- Name
	label({
		Name = "Name",
		Position = UDim2.fromOffset(108, 0),
		Size = UDim2.new(1, -108 - 150, 1, 0),
		Text = entry.Name .. (isMe and "  •  YOU" or ""),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	}, row, "White")

	-- Value
	label({
		Name = "Value",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.new(0, 140, 1, 0),
		Text = FORMAT[key](value),
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 2,
	}, row, function()
		return rankColor(rank) or UIColors.White
	end)

	-- Hover
	row.MouseEnter:Connect(function()
		local info = TweenInfo.new(0.12)
		TweenService:Create(row, info, { BackgroundTransparency = 0 }):Play()
		TweenService:Create(rowStroke, info, { Color = UIColors.GlassHover, Transparency = 0 }):Play()
	end)
	row.MouseLeave:Connect(function()
		local info = TweenInfo.new(0.15)
		TweenService:Create(row, info, { BackgroundTransparency = baseTransparency }):Play()
		TweenService:Create(rowStroke, info, {
			Color = baseStroke(),
			Transparency = (topThree or isMe) and 0.2 or 0.1,
		}):Play()
	end)
end

--==================================================
-- RENDER / TABS / DATA
--==================================================

function render()
	for _, child in ipairs(scroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	updateFooter()

	local payload = state.Payload
	if not payload then
		emptyLabel.Text = "LOADING…"
		emptyLabel.Visible = true
		return
	end

	local list = payload[state.Tab] or {}
	emptyLabel.Text = "NO ENTRIES YET"
	emptyLabel.Visible = #list == 0

	local maxValue = list[1] and list[1].Value or 1
	for rank, entry in ipairs(list) do
		buildRow(entry, rank, maxValue, payload.Me)
	end

	scroll.CanvasPosition = Vector2.zero
end

function setTab(key)
	if state.Tab == key then
		return
	end
	state.Tab = key
	styleTabs()
	render()
end

local function applyPayload(payload)
	state.Payload = payload
	state.Deadline = os.clock() + (payload.RefreshIn or 60)
	render()
end

local function pull()
	local ok, payload = pcall(function()
		return getBoards:InvokeServer()
	end)
	if ok and payload then
		applyPayload(payload)
	end
end

boardsUpdated.OnClientEvent:Connect(applyPayload)

-- Countdown label
task.spawn(function()
	while gui.Parent do
		task.wait(0.5)
		if state.Open then
			refreshValue.Text = math.max(0, math.ceil(state.Deadline - os.clock())) .. "s"
		end
	end
end)

--==================================================
-- OPEN / CLOSE / INPUT
--==================================================

function setOpen(open)
	state.Open = open

	if open then
		panel.Visible = true
		TweenService:Create(
			panelScale,
			TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		):Play()
		task.spawn(pull)
	else
		local tween = TweenService:Create(
			panelScale,
			TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = 0.92 }
		)
		tween:Play()
		tween.Completed:Once(function()
			if not state.Open then
				panel.Visible = false
			end
		end)
	end
end

toggle.MouseButton1Click:Connect(function()
	setOpen(not state.Open)
end)

closeButton.MouseButton1Click:Connect(function()
	setOpen(false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == TOGGLE_KEY then
		setOpen(not state.Open)
	end
end)

-- Cycle through every UIColors theme
-- Cycles only through themes the player owns (locked ones are skipped).
themeButton.MouseButton1Click:Connect(function()
	local names = UIColors.GetThemeNames()
	local index = table.find(names, UIColors.CurrentTheme) or 0

	for step = 1, #names do
		local nextName = names[((index + step - 1) % #names) + 1]

		local unlocked = true
		if UIColors.IsThemeUnlocked then
			unlocked = UIColors.IsThemeUnlocked(nextName)
		end

		if unlocked then
			UIColors.SetTheme(nextName)
			break
		end
	end
end)

