--==================================================
-- THEME BINDING
--==================================================
-- themed(inst, fn) runs fn now and again every time the theme changes.

local binders = {}
local themeHooks = {}

local function themed(inst, fn)
	fn(inst)
	table.insert(binders, { inst, fn })
	return inst
end

local function restyle()
	for i = #binders, 1, -1 do
		local inst, fn = binders[i][1], binders[i][2]
		if inst:IsDescendantOf(game) then
			fn(inst)
		else
			table.remove(binders, i)
		end
	end
	for _, hook in ipairs(themeHooks) do
		hook()
	end
end

--==================================================
-- SMALL BUILDERS
--==================================================

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(parent, offset, scale)
	return new("UICorner", { CornerRadius = UDim.new(scale or 0, offset) }, parent)
end

local function colorOf(key)
	if type(key) == "function" then
		return key()
	end
	return UIColors[key]
end

local function stroke(parent, thickness, colorKey, transparency)
	local s = new("UIStroke", {
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
	themed(s, function(x)
		x.Color = colorOf(colorKey)
	end)
	return s
end

local function label(props, parent, colorKey)
	props.BackgroundTransparency = 1
	props.Font = props.Font or FONT
	local l = new("TextLabel", props, parent)
	themed(l, function(x)
		x.TextColor3 = colorOf(colorKey or "White")
	end)
	return l
end

--==================================================
-- FORMATTING
--==================================================

local function commas(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,")
	out = out:reverse()
	return (out:gsub("^,", ""))
end

local function formatTime(seconds)
	seconds = math.floor(seconds)
	local d = seconds // 86400
	local h = (seconds % 86400) // 3600
	local m = (seconds % 3600) // 60

	if d > 0 then
		return string.format("%dd %dh", d, h)
	elseif h > 0 then
		return string.format("%dh %dm", h, m)
	end
	return string.format("%dm", m)
end

local FORMAT = {
	Donated = function(v)
		return "R$ " .. commas(v)
	end,
	Weekly = function(v)
		return "R$ " .. commas(v)
	end,
	Time = formatTime,
}

local function rankColor(rank)
	if rank == 1 then
		return UIColors.RankFirst
	elseif rank == 2 then
		return UIColors.RankSecond
	elseif rank == 3 then
		return UIColors.RankThird
	end
	return nil
end

